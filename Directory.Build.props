<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion><Deterministic>true</Deterministic><TreatWarningsAsErrors>false</TreatWarningsAsErrors><EnableNETAnalyzers>false</EnableNETAnalyzers>
    <HollowGameVersion Condition="'$(HollowGameVersion)' == ''">Legacy</HollowGameVersion>
    <HollowReferences>$(MSBuildThisFileDirectory)vendor/references</HollowReferences>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HollowGameVersion)' == 'Unity6'">
    <HollowReferences>$(MSBuildThisFileDirectory)vendor/references-unity6</HollowReferences>
    <BaseOutputPath>bin/Unity6/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/Unity6/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <DefineConstants>$(DefineConstants);HOLLOW_UNITY6</DefineConstants>
  </PropertyGroup>
</Project>